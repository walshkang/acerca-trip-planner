# Copy to `.env.local` and fill in values. Next.js loads `.env.local` for local dev.

# --- Routing preview (Plan mode travel times) ---
# Without a working provider, POST /api/lists/[id]/routing/preview returns 501
# with status "provider_unavailable" (expected until configured).
#
# Use OSRM for local/dev (public demo server — rate limits apply):
#   ROUTING_PROVIDER=osrm
#   OSRM_BASE_URL=https://router.project-osrm.org
#
# Or run your own OSRM and point OSRM_BASE_URL at its base (no trailing slash on /route path).
ROUTING_PROVIDER=
OSRM_BASE_URL=

# --- Optional beta gate (shared deploy / friends testing) ---
# When set, all app pages and /api/* (except /api/beta-unlock POST and /auth/*) require
# a signed cookie obtained via POST /api/beta-unlock. Keeps casual traffic off Google Places.
# Cookie signing key is derived from this password (HMAC); no separate secret required.
# To rotate everyone off without changing the password, you’d add a dedicated signing secret later.
# Use double quotes so spaces or # in the password don’t break parsing, e.g.:
# BETA_ACCESS_PASSWORD="test"
BETA_ACCESS_PASSWORD=

# --- Playwright E2E ---
# Email of an existing Supabase user. global-setup generates a magic link via the
# admin API and signs in headlessly — no email client or manual steps needed.
PLAYWRIGHT_TEST_EMAIL=
# Seed token for pre-seeding / post-cleanup (matches /api/test/seed x-seed-token).
# PLAYWRIGHT_SEED_TOKEN=
# Override default E2E base URL (defaults to http://localhost:3010).
# PLAYWRIGHT_BASE_URL=http://localhost:3010

# --- Social Discovery Pipeline ---
# Secret key for ingestion API auth.
SOCIAL_INGEST_KEY=
# Client-accessible copy for browser calls to fetch-content / ingest-social (same value as SOCIAL_INGEST_KEY).
NEXT_PUBLIC_SOCIAL_INGEST_KEY=
# Fixed UUID for system-owned social places.
SOCIAL_SYSTEM_USER_ID=
# Gemini model id for social extraction (default: gemini-1.5-flash).
SOCIAL_EXTRACTION_MODEL=
# Chunk long transcripts for LLM (defaults: 8000 / 200).
SOCIAL_CHUNK_MAX_CHARS=
SOCIAL_CHUNK_OVERLAP=
# Worker: POST/GET /api/internal/process-social-jobs (service role + claim RPC). Use the same value as Vercel CRON_SECRET or set independently.
PROCESS_SOCIAL_JOBS_KEY=
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> when this is set in the project.
CRON_SECRET=
# Needed by `npm run seed:social`:
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
